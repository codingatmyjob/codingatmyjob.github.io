---
import '../../style.css'
import BinaryBackground from '../components/BinaryBackground.astro'
import { getSiteUrl } from '../siteUrls.js'

const {
  title = 'Cybersecurity & Data Science Portfolio',
  description = 'Explore cybersecurity and data science projects, interactive demos, technical notes, and experiments on Tangent.',
  canonical = getSiteUrl(),
  image = getSiteUrl('images/cover/og-image.png'),
  imageAlt = 'Tangent site preview',
  type = 'website',
  bodyClass = ''
} = Astro.props
const brandedTitle = `Tangent | ${title}`
const basePath = import.meta.env.BASE_URL || '/'
const sitePath = (path) => `${basePath}${String(path).replace(/^\/+/, '')}`
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{brandedTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {basePath === '/preview/' && <meta name="robots" content="noindex, nofollow" />}
    <link
      id="tab-icon"
      rel="icon"
      type="image/png"
      sizes="48x48"
      href={sitePath('favicon/favicon-48x48.png?v=2')}
      data-dark-src={sitePath('favicon/favicon-48x48-dark.png?v=2')}
    />
    <link
      id="apple-touch-icon"
      rel="apple-touch-icon"
      sizes="180x180"
      href={sitePath('favicon/apple-touch-icon.png?v=2')}
      data-dark-src={sitePath('favicon/apple-touch-icon-dark.png?v=2')}
    />
    <link
      id="app-manifest"
      rel="manifest"
      href={sitePath('favicon/site.webmanifest?v=2')}
      data-dark-src={sitePath('favicon/site-dark.webmanifest?v=2')}
    />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={brandedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={brandedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <slot name="head" />
    <script is:inline>
      const colorScheme = window.matchMedia('(prefers-color-scheme: dark)')
      const tabIcon = document.getElementById('tab-icon')
      const appleTouchIcon = document.getElementById('apple-touch-icon')
      const appManifest = document.getElementById('app-manifest')
      const lightAssets = [tabIcon.href, appleTouchIcon.href, appManifest.href]
      const updateThemeAssets = () => {
        const useDarkAssets = colorScheme.matches
        tabIcon.href = useDarkAssets ? tabIcon.dataset.darkSrc : lightAssets[0]
        appleTouchIcon.href = useDarkAssets ? appleTouchIcon.dataset.darkSrc : lightAssets[1]
        appManifest.href = useDarkAssets ? appManifest.dataset.darkSrc : lightAssets[2]
      }
      updateThemeAssets()
      if (typeof colorScheme.addEventListener === 'function') colorScheme.addEventListener('change', updateThemeAssets)
      else colorScheme.addListener(updateThemeAssets)

      try {
        const savedTheme = localStorage.getItem('theme')
        document.documentElement.dataset.theme = savedTheme || (colorScheme.matches ? 'dark' : 'light')
      } catch {
        document.documentElement.dataset.theme = 'light'
      }
    </script>
  </head>
  <body class={bodyClass}>
    <BinaryBackground />
    <div class="container">
      <header class="site-header">
        <button class="menu-toggle" type="button" aria-label="Toggle menu" aria-controls="sidebar" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" />
          </svg>
        </button>
        <a class="site-brand" href={sitePath('')} aria-label="Tangent home">
          <img class="site-brand-logo site-brand-logo-dark" src={sitePath('images/tangent-logo-color-on-navy.svg')} alt="" aria-hidden="true" />
          <img class="site-brand-logo site-brand-logo-light" src={sitePath('images/tangent-logo-color.svg')} alt="" aria-hidden="true" />
        </a>
        <div class="header-controls">
          <button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false">
            <svg class="theme-toggle-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2m10-10h-2M4 12H2m17-7-1.4 1.4M6.4 17.6 5 19m14 0-1.4-1.4M6.4 6.4 5 5" />
            </svg>
            <svg class="theme-toggle-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
            </svg>
          </button>
        </div>
      </header>
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-overlay" data-sidebar-close></div>
        <div class="sidebar-content">
          <div class="sidebar-header-title" hidden>
            <h2 class="title"><a href={sitePath('')} aria-label="Return Home">Tangent</a></h2>
          </div>
          <nav class="sidebar-nav" aria-label="Main navigation">
            <div class="sidebar-top">
              <button class="sidebar-close-toggle" type="button" aria-label="Close menu">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" />
                </svg>
              </button>
              <div class="sidebar-divider"></div>
              <a class="sidebar-item" href={sitePath('')}>
                <svg class="sidebar-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" /></svg>
                Home
              </a>
              <a class="sidebar-item" href={sitePath('sidebar/About/')}>
                <svg class="sidebar-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" /></svg>
                About Me
              </a>
              <a class="sidebar-item" href={sitePath('sidebar/status-hub/')}>
                <svg class="sidebar-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M4 13h6V4H4v9zm0 7h6v-5H4v5zm8 0h8v-9h-8v9zm0-16v5h8V4h-8z" /></svg>
                Status Hub
              </a>
            </div>
            <div class="sidebar-bottom">
              <div class="sidebar-divider"></div>
              <a class="sidebar-section-label sidebar-env-label" href={basePath === '/preview/' ? '/' : '/preview/'}>
                You're On: {basePath === '/preview/' ? 'Preview' : 'Production'} ↗
              </a>
              <span class="sidebar-section-label">Modified: {import.meta.env.VITE_BUILD_TIME || 'dev'}</span>
            </div>
          </nav>
        </div>
      </aside>
      <div class="main-content">
        <slot />
      </div>
      <footer class="site-footer">
        <div class="footer-signoff">
          <img class="footer-icon footer-icon-dark" src={sitePath('images/tangent-mark-dark.svg')} alt="" aria-hidden="true" />
          <img class="footer-icon footer-icon-light" src={sitePath('images/tangent-mark.svg')} alt="" aria-hidden="true" />
          <div><strong>Tangent</strong><div class="copyright">© 2026</div></div>
        </div>
        <div class="social-links">
          <a href="https://github.com/codingatmyjob/" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.4 7.86 10.94.57.1.78-.25.78-.56v-2.02c-3.2.7-3.87-1.55-3.87-1.55-.52-1.3-1.27-1.64-1.27-1.64-1.04-.7.08-.68.08-.68 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.33.95.1-.74.4-1.24.73-1.53-2.56-.29-5.26-1.28-5.26-5.72 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.14 1.18.91-.25 1.88-.38 2.85-.38s1.94.13 2.85.38c2.18-1.49 3.14-1.18 3.14-1.18.62 1.58.23 2.75.11 3.04.73.81 1.18 1.84 1.18 3.1 0 4.46-2.7 5.42-5.27 5.7.41.35.77 1.04.77 2.1v3.12c0 .31.21.67.79.56A10.51 10.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z" /></svg>
          </a>
          <a href="https://app.hackthebox.com/profile/2578864" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="Hack The Box" title="Hack The Box">
            <svg viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><path d="M256 0L32 128v256l224 128 224-128V128L256 0zm0 48l176 96v224l-176 96-176-96V144l176-96z" /></svg>
          </a>
          <a href="https://www.credly.com/users/connor-rasmussen.58b75ec0/badges#credly" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="Credly" title="Credly">
            <svg viewBox="0 0 48 48" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8 0h32a8 8 0 0 1 8 8v32a8 8 0 0 1-8 8H8a8 8 0 0 1-8-8V8a8 8 0 0 1 8-8zm25.77 27.04c-.71-.5-1.68-.32-2.18.39-2.14 2.96-5.22 5.57-9.58 5.57s-4.62-7.88-2-13c1.61-3.14 3.87-5.73 5.84-5.72 1.39 0 2.18 1.26 1.8 2.6-.46 1.63-.51 2.72-.51 2.81-.04.96.71 1.77 1.68 1.8.02 0 .04.01.07.01.93 0 1.7-.74 1.74-1.68 0-.03.18-3.31 2.78-6.77.63-.84.39-2.07-.57-2.59-.77-.42-1.75-.14-2.27.56-.15.2-.29.39-.42.59-.14.2-.4.27-.62.17-7.7-3.47-12.07 3.86-13.51 7.23-3 7-3 18 5.62 18 7.22 0 10.63-4.75 12.6-7.79.46-.71.27-1.66-.42-2.14z" /></svg>
          </a>
        </div>
      </footer>
    </div>
    <button id="scroll-top" class="scroll-top" aria-label="Scroll to top" type="button" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="18 15 12 9 6 15" /></svg>
    </button>
    <script>
      import '../scripts/site.js'
    </script>
    <slot name="scripts" />
  </body>
</html>
