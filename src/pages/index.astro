---
import SiteLayout from '../layouts/SiteLayout.astro'
import ArticleCard from '../components/ArticleCard.astro'
import PortfolioIntro from '../components/PortfolioIntro.astro'
import { articlesData } from '../data/articles.js'
import { getSiteUrl } from '../siteUrls.js'

const basePath = import.meta.env.BASE_URL || '/'
const pageTitle = 'Tangent | Cybersecurity & Data Science Blog'
const votesApi = import.meta.env.PUBLIC_VOTES_API_URL?.trim()
const tags = [...new Set(articlesData.flatMap((article) => article.tags))].sort()
const canonical = getSiteUrl()
const featured = [
  { id: 'how-fit-am-i', caption: '01 / Running analytics' },
  { id: 'traffic-live-object-detection', caption: '02 / Computer vision' },
  { id: 'prompt-injection-demo', caption: '03 / AI security' }
].flatMap(({ id, caption }) => {
  const item = articlesData.find((article) => article.id === id)
  return item ? [{ item, caption }] : []
})
const homeSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': canonical,
      url: canonical,
      name: 'Tangent',
      description: 'A cybersecurity and data science blog with technical notes, project builds, experiments, reviews, and practical writeups.',
      inLanguage: 'en'
    },
    {
      '@type': 'Blog',
      name: 'Tangent',
      description: 'A cybersecurity and data science blog with technical notes, project builds, experiments, reviews, and practical writeups.',
      inLanguage: 'en',
      isPartOf: { '@id': canonical }
    }
  ]
}).replace(/</g, '\\u003c')
---

<SiteLayout
  title={pageTitle}
  description="A cybersecurity and data science blog with technical notes, project builds, experiments, reviews, and practical writeups, that together form a practical project portfolio."
  canonical={canonical}
>
  <script slot="head" type="application/ld+json" set:html={homeSchema}></script>

  <section class="content-area">
    <div id="articles-view">
      <div class="articles-controls">
        <div id="articles-controls-root">
          <div class="articles-controls-wrapper">
            <div class="search-controls-row">
              <div class="search-bar-container">
                <div class="search-bar">
                  <div class="search-input-wrapper">
                    <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                      <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
                    </svg>
                    <input id="article-search" type="search" class="search-input" placeholder="Search articles..." aria-label="Search articles" />
                    <span class="search-spinner" aria-hidden="true" hidden><span class="spinner-circle"></span></span>
                    <button class="search-clear" type="button" aria-label="Clear search" title="Clear search" hidden>
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59l-5.58-5.58z" /></svg>
                    </button>
                  </div>
                </div>
              </div>
            </div>
            <div class="controls-row">
              <div class="sort-dropdown-wrap">
                <button id="sort-toggle" class="sort-toggle" type="button" aria-expanded="false" aria-label="Sort: Newest" title="Sort: Newest">
                  <svg class="sort-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M3 18h6v-2H3v2zM3 6v2h18V6H3zm0 7h12v-2H3v2z" /></svg>
                  <span class="sort-label">Newest</span>
                  <svg class="dropdown-arrow arrow-down" width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M6 9 1 4h10z" /></svg>
                </button>
                <div class="sort-dropdown" hidden>
                  <div class="sort-options-list">
                    {[
                      ['newest', 'Newest'],
                      ['oldest', 'Oldest'],
                      ['a-z', 'A-Z'],
                      ['z-a', 'Z-A']
                    ].map(([value, label]) => (
                      <button class="sort-option" type="button" data-sort={value}>{label}</button>
                    ))}
                    {votesApi && <button class="sort-option" type="button" data-sort="votes">Votes</button>}
                  </div>
                </div>
              </div>
              <div class="filter-dropdown-wrap">
                <button id="filter-toggle" class="filter-toggle" type="button" aria-expanded="false" aria-controls="tag-filter-panel" aria-label="Filter by tag" title="Filter by tag">
                  <svg class="filter-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M3 5h18v2l-7 7v5l-4 2v-7L3 7V5z" /></svg>
                  <span class="filter-label">Filter</span>
                  <span class="filter-count" aria-hidden="true"></span>
                </button>
                <div id="tag-filter-panel" class="filter-panel" role="menu" hidden>
                  <div class="filter-panel-body">
                    <div id="tag-filter-list" class="tag-filter-list" role="group" aria-label="Tag filters">
                      {tags.map((tag) => <button class="filter-item" type="button" data-tag={tag} aria-pressed="false">{tag}</button>)}
                    </div>
                  </div>
                  <div class="filter-panel-footer">
                    <button id="filter-clear-btn" class="filter-clear-btn" type="button">Clear</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="portfolio-showcase" id="portfolio-showcase">
        <PortfolioIntro pageTitle={pageTitle} />
        {featured.length > 0 && (
          <section aria-labelledby="highlighted-work-heading">
            <div class="portfolio-section-heading">
              <h2 id="highlighted-work-heading">Highlights</h2>
              <a class="gallery-jump" href="#gallery">Gallery <span aria-hidden="true">&darr;</span></a>
            </div>
            <div class="feature-grid">
              <div class="feature-lead">
                <ArticleCard item={featured[0].item} basePath={basePath} priority featureCaption={featured[0].caption} />
              </div>
              {featured.length > 1 && (
                <div class="feature-picks">
                  {featured.slice(1).map(({ item, caption }) => (
                    <ArticleCard item={item} basePath={basePath} featureCaption={caption} showCover={false} />
                  ))}
                </div>
              )}
            </div>
          </section>
        )}
      </div>
      <div class="portfolio-section-heading gallery-heading" id="gallery" tabindex="-1">
        <span class="gallery-anchor" id="archive" aria-hidden="true"></span>
        <h2>Gallery <span id="gallery-count" aria-live="polite">{articlesData.length} entries</span></h2>
        <div class="article-layout-controls" id="article-layout-controls" role="group" aria-label="Article layout" hidden>
          <button type="button" data-layout="grid" aria-label="Grid view" title="Grid view" aria-controls="articles-grid" aria-pressed="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M3 3h8v8H3zm10 0h8v8h-8zM3 13h8v8H3zm10 0h8v8h-8z" />
            </svg>
          </button>
          <button type="button" data-layout="wide" aria-label="Wide view" title="Wide view" aria-controls="articles-grid" aria-pressed="false">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M3 4h18v2H3zm0 7h18v2H3zm0 7h18v2H3z" />
            </svg>
          </button>
        </div>
      </div>
      <div class="articles-grid" id="articles-grid">
        {articlesData.map((item, index) => <ArticleCard item={item} basePath={basePath} priority={index === 0} />)}
      </div>
      <div class="pagination-container" hidden>
        <div class="pagination">
          <button class="pagination-btn" type="button" aria-label="First page" title="Go to first page">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6v12m16-6H8m6-5-6 5 6 5" /></svg>
          </button>
          <button class="pagination-btn" type="button" aria-label="Previous page">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H4m6-5-6 5 6 5" /></svg>
          </button>
          <div class="pagination-info">
            <span class="pagination-current">1</span>
            <span class="pagination-separator">/</span>
            <span class="pagination-total">1</span>
          </div>
          <button class="pagination-btn" type="button" aria-label="Next page">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-5 6 5-6 5" /></svg>
          </button>
          <button class="pagination-btn" type="button" aria-label="Last page" title="Go to last page">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6v12M4 12h12m-6-5 6 5-6 5" /></svg>
          </button>
        </div>
      </div>
      <div id="home-data" data-articles={JSON.stringify(articlesData)} data-base={basePath} data-votes-api={votesApi} hidden></div>
    </div>
  </section>
  <script>
    import '../scripts/home.js'
  </script>
</SiteLayout>
