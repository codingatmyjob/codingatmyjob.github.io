---
import SiteLayout from '../layouts/SiteLayout.astro'
import { getSiteUrl } from '../siteUrls.js'
---

<SiteLayout
  title="Page not found"
  description="The page you're looking for could not be found."
  canonical={getSiteUrl('404.html')}
  bodyClass="article-open"
>
  <div id="article-view">
    <main class="article-container not-found-container">
      <div class="not-found-code">404</div>
      <h1>Page not found</h1>
      <p>This page may have moved. You can find projects and articles in the Gallery.</p>
      <a class="article-home-btn" href={import.meta.env.BASE_URL || '/'}>
        <span class="article-home-btn-icon" aria-hidden="true">&larr;</span>
        <span>Return Home</span>
      </a>
    </main>
  </div>
</SiteLayout>
