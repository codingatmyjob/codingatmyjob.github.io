---
interface Props {
  size: number
  clipId: string
}

const { size, clipId } = Astro.props
---

<svg class="brand-mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <path d="M3 5h27Q26 12 21 12h-4v16h-7V12H3Z" fill="currentColor"/>
  <clipPath id={clipId}>
    <rect x="17" width="15" height="32"/>
  </clipPath>
  <g clip-path={`url(#${clipId})`}>
    <path d="M16 22.9Q23 22.9 28.5 13.2M23.9 19.4Q27.9 19.5 29 24.5" transform="translate(2.04 2.748) scale(.88)" fill="none" stroke="#e0882f" stroke-linecap="round" stroke-width="2.5"/>
  </g>
</svg>
