---
const { item, basePath = '/', priority = false, featureCaption = '', showCover = true } = Astro.props
const href = `${basePath}articles/${item.path.replace(/^articles\//, '').replace(/\.html$/, '')}/`
const imageSrc = item.imageSrc
  ? item.imageSrc.startsWith('http')
    ? item.imageSrc
    : item.imageSrc.startsWith('/')
      ? `${basePath}${item.imageSrc.replace(/^\/+/, '')}`
    : `${basePath}${item.imageSrc}`
  : ''
---

<a class="article-card" href={href} data-path={item.path}>
  {showCover && <div class="article-image">
    {imageSrc ? (
      <img
        class:list={['article-card-image', item.imageClassName]}
        src={imageSrc}
        alt={item.imageAlt || item.title || 'Article image'}
        data-image-inset={item.imageInset}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
      />
    ) : (
      item.imageLabel || item.title
    )}
  </div>}
  <div class="article-content">
    {featureCaption && <div class="feature-caption">{featureCaption}<span aria-hidden="true">&#8599;</span></div>}
    <div class="article-card-meta">
      <div class="article-card-byline">
        <div class="article-date">{item.date}</div>
        {item.readingTime && <div class="reading-time">{item.readingTime} read</div>}
      </div>
    </div>
    {featureCaption ? <h2 class="article-title">{item.title}</h2> : <div class="article-title">{item.title}</div>}
    <div class="article-description">{item.description}</div>
    <div class="article-tags">
      {item.tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
  </div>
</a>
