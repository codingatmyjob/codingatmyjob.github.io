{
  "name": "codingatmyjob-site",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run generate:related && npm run generate:read-times",
    "build": "vite-react-ssg build",
    "build:ci": "npm run generate:related && npm run generate:read-times && vite-react-ssg build",
    "preview": "vite preview",
    "lint": "eslint scripts tests vite.config.js eslint.config.cjs --ext .js,.jsx,.cjs,.mjs",
    "test": "vitest run",
    "generate:related": "node scripts/generate-related-articles.cjs",
    "generate:read-times": "node scripts/generate-read-times.cjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "prismjs": "^1.30.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.4",
    "vite-react-ssg": "^0.9.1-beta.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.37.0",
    "gh-pages": "^6.3.0",
    "globals": "^16.4.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
