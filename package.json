{
  "name": "codingatmyjob-site",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "prebuild": "npm run generate:related && npm run generate:read-times",
    "build": "astro build",
    "build:ci": "npm run build",
    "preview": "astro preview --host 0.0.0.0",
    "lint": "eslint scripts tests src/scripts astro.config.mjs eslint.config.cjs --ext .js,.cjs,.mjs",
    "test": "vitest run",
    "generate:related": "node scripts/generate-related-articles.cjs",
    "generate:read-times": "node scripts/generate-read-times.cjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist/client"
  },
  "dependencies": {
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "astro": "^7.4.13",
    "eslint": "^9.37.0",
    "gh-pages": "^6.3.0",
    "globals": "^16.4.0",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
