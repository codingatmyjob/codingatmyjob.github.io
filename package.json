{
  "name": "codingatmyjob-site",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "prebuild": "npm run generate:related && npm run generate:read-times",
    "build": "react-router build && node scripts/copy-spa-fallback.mjs",
    "build:ci": "npm run build",
    "preview": "vite preview --outDir dist/client",
    "lint": "eslint scripts tests vite.config.js eslint.config.cjs --ext .js,.jsx,.cjs,.mjs",
    "test": "vitest run",
    "generate:related": "node scripts/generate-related-articles.cjs",
    "generate:read-times": "node scripts/generate-read-times.cjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist/client"
  },
  "dependencies": {
    "@react-router/node": "^7.18.6",
    "isbot": "^5.2.3",
    "prismjs": "^1.30.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@react-router/dev": "^7.18.6",
    "eslint": "^9.37.0",
    "gh-pages": "^6.3.0",
    "globals": "^16.4.0",
    "vite": "^7.3.6",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
